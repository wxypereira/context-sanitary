# Configurações de Memória Persistente (Opcionais)

# Obsidian Vault Path
VAULT_PATH=/home/pereira/ObsidianVault

# Honcho AI API Key & Workspace
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=

# Provedores Remotos (Mem0 / Supermemory)
MEM0_API_KEY=
SUPERMEMORY_API_KEY=

# Provedor Padrão de Memória (ai-memory | obsidian | holographic | honcho | mem0 | supermemory | all)
MEMORY_PROVIDER=all
